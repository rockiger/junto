# Copy to `.env.local` and fill in from Google Cloud Console.
# Restart the dev server after changes (`bun run start`).

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_API_KEY=your-api-key
VITE_GOOGLE_APP_ID=your-app-id

# Optional: used when host is localhost:5763 or pro.fulcrum.wiki
VITE_API_KEY_PRO=your-pro-api-key
